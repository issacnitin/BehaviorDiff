<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BehaviorDiff.Cli</RootNamespace>
    <AssemblyName>behaviordiff</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>behaviordiff</ToolCommandName>
    <PackageId>BehaviorDiff.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>Nitin Issac Joy</Authors>
    <Description>Detect behavior changes between two .NET, Java, or Node builds by tracing and comparing test execution.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/issacnitin/BehaviorDiff</PackageProjectUrl>
    <RepositoryUrl>https://github.com/issacnitin/BehaviorDiff.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddWeaverRuntimeDependenciesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContainedRelease)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced so the tracer and its runtime dependencies land in this app's output and can be
         copied into the injection kit; the CLI itself never calls into them. -->
        <ProjectReference Include="..\BehaviorDiff.Tracer.Xunit\BehaviorDiff.Tracer.Xunit.csproj"
                      Condition="'$(SelfContainedRelease)' != 'true'" />
        <ProjectReference Include="..\..\tools\Weaver\Weaver.csproj"
              ReferenceOutputAssembly="false"
                      Condition="'$(SelfContainedRelease)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(SelfContainedRelease)' == 'true'">
    <Content Include="..\..\tools\Weaver\bin\$(Configuration)\net8.0\behaviordiff-weaver.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\behaviordiff-weaver.deps.json;..\..\tools\Weaver\bin\$(Configuration)\net8.0\behaviordiff-weaver.runtimeconfig.json;..\..\tools\Weaver\bin\$(Configuration)\net8.0\BehaviorDiff.Contracts.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\BehaviorDiff.Tracer.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\Mono.Cecil.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\Mono.Cecil.Mdb.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\Mono.Cecil.Pdb.dll;..\..\tools\Weaver\bin\$(Configuration)\net8.0\Mono.Cecil.Rocks.dll;..\BehaviorDiff.Tracer.Xunit\bin\$(Configuration)\netstandard2.0\BehaviorDiff.Tracer.Xunit.dll"
             Link="%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- The weaver reflection-loads target assemblies and therefore needs its own runtimeconfig with
       RollForward=LatestMajor. Copying its complete output preserves that separate process boundary. -->
  <Target Name="CopyBehaviorDiffWeaver" AfterTargets="Build" Condition="'$(SelfContainedRelease)' != 'true'">
    <ItemGroup>
      <_BehaviorDiffWeaverFiles Include="$(MSBuildThisFileDirectory)..\..\tools\Weaver\bin\$(Configuration)\net8.0\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BehaviorDiffWeaverFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildSelfContainedReleasePayloads"
          BeforeTargets="PrepareForPublish"
          Condition="'$(SelfContainedRelease)' == 'true'">
    <MSBuild Projects="..\BehaviorDiff.Tracer.Xunit\BehaviorDiff.Tracer.Xunit.csproj;..\..\tools\Weaver\Weaver.csproj"
             Targets="Build"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;SelfContainedRelease" />
  </Target>

  <ItemGroup>
    <!-- The adapter is recompiled per target repo against that repo's own xunit version, so its source
         is embedded rather than copied - a second copy would drift from the type actually shipped. -->
    <EmbeddedResource Include="..\BehaviorDiff.Tracer.Xunit\TraceTestAttribute.cs" LogicalName="TraceTestAttribute.cs" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\tools\Weaver\bin\$(Configuration)\net8.0\behaviordiff-weaver.dll"
          Pack="true" PackagePath="tools\net8.0\any" />
  </ItemGroup>

  <Target Name="AddWeaverRuntimeDependenciesToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\..\tools\Weaver\bin\$(Configuration)\net8.0\Mono.Cecil*.dll">
        <PackagePath>tools\net8.0\any</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(CrossLanguageTracerRoot)' != '' and Exists('$(CrossLanguageTracerRoot)')">
    <_CrossLanguageTracerFiles Include="$(CrossLanguageTracerRoot)\**\*" />
    <None Include="@(_CrossLanguageTracerFiles)"
          Pack="true"
          PackagePath="tools\net8.0\any\tracers\%(RecursiveDir)"
          Link="tracers\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RustEngineRoot)' != '' and Exists('$(RustEngineRoot)')">
    <_RustEngineFiles Include="$(RustEngineRoot)\**\*" />
    <None Include="@(_RustEngineFiles)"
          Link="engines\rust\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
