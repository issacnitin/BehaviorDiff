<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Loaded into the target process under test, which may be .NET Framework or any .NET Core version. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>BehaviorDiff.Tracer</RootNamespace>
    <AssemblyName>BehaviorDiff.Tracer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BehaviorDiff.Contracts\BehaviorDiff.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The weaver derives scope from the real MethodSelector rather than reimplementing its predicates. -->
    <InternalsVisibleTo Include="behaviordiff-weaver" />
  </ItemGroup>

  <ItemGroup>
    <!-- Portable PDB sequence points. In-box from net5.0 on, but netstandard2.0 needs the package. -->
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
    <!-- ValueTask / ValueTask<T> are absent from the netstandard2.0 reference assemblies. -->
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

</Project>
