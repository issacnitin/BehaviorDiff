<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single TFM on purpose. Multi-targeting this assembly is actively unsafe: `init` accessors carry a
         modreq on IsExternalInit, which comes from a local shim on netstandard2.0 and from System.Runtime
         on net8.0. Those two setters have different signatures, so a caller compiled against one leg fails
         with MissingMethodException when the other leg is the one actually loaded. Contracts needs nothing
         newer than netstandard2.0, so there is one assembly and one signature for everybody. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RealDiff.Contracts</RootNamespace>
    <AssemblyName>RealDiff.Contracts</AssemblyName>
  </PropertyGroup>

</Project>
